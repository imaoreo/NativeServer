// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  discordId String?  @unique

  devices   Device[] @relation("UserOwnedDevices")
  storageItems Storage[] @relation("UserStorage")
}

model GrindrProfile {
  id                    String                 @id // Grindr profile ID
  displayName           String?
  age                   Int?
  profileImageMediaHash String?
  aboutMe               String?
  onlineUntil           DateTime?
  rawData               String                 // Stores the full raw JSON of the profile
  lastSeen              DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  history               GrindrProfileHistory[]
  medias                GrindrProfileMedia[]
  distances             GrindrProfileDistance[]
}

model GrindrProfileHistory {
  id        String        @id @default(uuid())
  profileId String
  profile   GrindrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  diffJson  String        // The JSON representation of changed fields (previous values)
  createdAt DateTime      @default(now())

  @@index([profileId])
}

model GrindrProfileDistance {
  id        String        @id @default(uuid())
  profileId String
  profile   GrindrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  distance  Float         // Distance in meters
  geohash   String        // Geohash of the querying client
  createdAt DateTime      @default(now())

  @@index([profileId])
}

model GrindrProfileMedia {
  mediaHash     String        @id
  profileId     String
  profile       GrindrProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type          Int
  state         Int
  reason        String?
  takenOnGrindr Boolean?
  createdAt     DateTime?     // Grindr media creation date
  firstSeen     DateTime      @default(now())
  lastSeen      DateTime      @default(now())
  hasImage      Boolean       @default(false)

  @@index([profileId])
}

model Device {
  id        String   @id @default(uuid())
  name      String
  publicKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String?
  user      User?    @relation("UserOwnedDevices", fields: [userId], references: [id], onDelete: SetNull)
  
  addedById String?
  addedBy   Device?  @relation("DeviceHierarchy", fields: [addedById], references: [id])
  children  Device[] @relation("DeviceHierarchy")

  modifiedItems Storage[]         @relation("DeviceLastModified")

  @@index([userId])
  @@index([addedById])
}

model Storage {
  id               String   @id @default(uuid())
  location         String   
  
  encryptedPayload String   

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId           String
  user             User     @relation("UserStorage", fields: [userId], references: [id], onDelete: Cascade)
  
  lastModifiedById String?
  lastModifiedBy   Device?  @relation("DeviceLastModified", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  
  @@unique([userId, location])
  @@index([userId])
}

model GrindrAlbumMedia {
  albumId        String
  contentId      String
  ownerProfileId String
  contentType    String
  fileName       String
  uploadedById   String?
  createdAt      DateTime @default(now())

  @@id([albumId, contentId])
  @@index([ownerProfileId])
}
